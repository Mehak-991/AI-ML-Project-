# Copy this file to .env and adjust values for your environment.
# Never commit .env to version control.

# ── Ollama (local LLM — no API key required) ──────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL example (requires a running PostgreSQL server):
DATABASE_URL=postgresql://postgres:password@localhost:5432/aimldb

# SQLite example (no server needed — just comment out the line above and
# uncomment the line below):
# DATABASE_URL=sqlite:///./aiml.db
