# Production configuration for `docker compose`. Copy to .env.production and fill in:
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#   docker compose --env-file .env.production up -d --build
#
# Never commit .env.production. Everything not listed here falls back to the safe default
# in app/core/config.py. compose.yaml itself forces APP_ENV=production, DEBUG=false,
# DATABASE_ECHO=false and LOG_FORMAT=json for the backend containers.

# Which file the containers load (must match --env-file above).
ENV_FILE=.env.production

# --- Required: compose and the application refuse to start without these -------------------
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32   (>= 32 bytes; rotating it signs every user out)
JWT_SECRET_KEY=

# --- Database and images --------------------------------------------------------------------
POSTGRES_USER=aiproject
POSTGRES_DB=aiproject
APP_VERSION=0.5.0-p21

# --- Network --------------------------------------------------------------------------------
# Host port for nginx. Terminate TLS in front of this; see DEPLOYMENT_GUIDE.md.
FRONTEND_PORT=80
# Only change these if 172.21.0.0/16 clashes with another network on the host. nginx's address
# is the only one trusted to set X-Forwarded-For.
FRONTEND_SUBNET=172.21.0.0/16
FRONTEND_PROXY_IP=172.21.0.10
# Browser origins, comma-separated. Empty is right when the SPA and API share an origin via nginx.
CORS_ORIGINS=
# Serve Swagger UI and the OpenAPI schema publicly.
PROD_DOCS_ENABLED=false

# --- Logging, limits, metrics ----------------------------------------------------------------
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
# openssl rand -hex 24. Requires Prometheus to send "Authorization: Bearer <token>".
METRICS_TOKEN=

# --- LLM (optional; the rest of the app works without it) --------------------------------------
# ollama = local server on the Docker host (free) | openai = hosted (paid, needs OPENAI_API_KEY)
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b
# Ollama must listen on an address containers can reach (OLLAMA_HOST=0.0.0.0).
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
# OPENAI_API_KEY=
INSTALL_LLM=false
INSTALL_NLP=false
