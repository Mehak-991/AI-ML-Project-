# Copy to .env and adjust. Never commit .env or real credentials.

APP_NAME=AIProject
# development | testing | production
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Comma-separated list of allowed browser origins. Leave unset for defaults
# (localhost:3000 in development, none in production). "*" is rejected in production.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required when APP_ENV=production. Optional in development.
# DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/<database>
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT=5
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Server-side storage directories (relative to the working directory).
UPLOAD_DIR=uploads
MODEL_DIR=trained_models

# Data / ML limits
MAX_UPLOAD_SIZE_MB=25
MAX_DATASET_ROWS=200000
MAX_DATASET_COLUMNS=500
MAX_PREDICTION_RECORDS=1000

# --- LLM provider (optional; the app starts without it) -------------------------
# Leave empty to disable /llm/chat and /nlp/analyze (they return 503 with a hint).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Extra models a request may choose via "model" (comma-separated). Controls cost.
OPENAI_ALLOWED_MODELS=
# OPENAI_BASE_URL=            # for an OpenAI-compatible gateway/proxy
# OPENAI_ORGANIZATION=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
LLM_MAX_MESSAGES=50
LLM_MAX_INPUT_CHARS=32000
LLM_MAX_INPUT_TOKENS=8000
LLM_MAX_OUTPUT_TOKENS=4096
LLM_DEFAULT_OUTPUT_TOKENS=1024
# Never log prompts/completions unless you explicitly need to debug locally.
LLM_LOG_CONTENT=false

# --- Local models (optional extras: torch + nlp) --------------------------------
# auto = CUDA if available, else Apple MPS, else CPU
AI_DEVICE=auto
# Where Hugging Face models are cached (default: ~/.cache/huggingface).
# AI_MODEL_CACHE_DIR=./model_cache
# false = offline mode: only use models already downloaded (see scripts/download_models.py)
AI_ALLOW_MODEL_DOWNLOADS=true
AI_MAX_LOADED_MODELS=3
AI_INFERENCE_TIMEOUT_SECONDS=60
AI_MAX_CONCURRENT_INFERENCES=2

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Pin the vector size you store (all-MiniLM-L6-v2 = 384). Empty = accept the model's size.
EMBEDDING_DIMENSION=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_TEXTS=128
EMBEDDING_MAX_TEXT_CHARS=8000

CLASSIFIER_MODEL=distilbert/distilbert-base-uncased-finetuned-sst-2-english
CLASSIFIER_MAX_TEXTS=64
CLASSIFIER_MAX_TEXT_CHARS=4000

TOKENIZER_MAX_TEXT_CHARS=200000

# Only used by tests/integration; point at a disposable database.
# TEST_DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/<test_database>
