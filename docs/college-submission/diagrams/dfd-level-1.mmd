flowchart TB
    user([User / Admin / Superadmin])

    p1((1.0<br/>Authentication<br/>and RBAC))
    p2((2.0<br/>Dataset<br/>management))
    p3((3.0<br/>Model training<br/>and evaluation))
    p4((4.0<br/>Prediction and<br/>explainability))
    p5((5.0<br/>Deployment and<br/>drift monitoring))
    p6((6.0<br/>Administration<br/>and audit))

    d1[(D1 users, refresh_tokens)]
    d2[(D2 datasets + uploaded files)]
    d3[(D3 ml_models, experiments, jobs<br/>+ model artifacts)]
    d4[(D4 prediction_logs)]
    d5[(D5 deployments, drift_reports, drift_alerts)]
    d6[(D6 audit_logs)]

    user -->|login, register, refresh| p1
    p1 <--> d1
    p1 -->|access token + permissions| user

    user -->|CSV or XLSX upload| p2
    p2 <--> d2
    p2 -->|validation report, preview, profile| user

    user -->|training request| p3
    p3 -->|read data| d2
    p3 -->|model, metrics, cross-validation| d3
    p3 -->|job status| user

    user -->|records to score| p4
    p4 -->|load model| d3
    p4 -->|log prediction| d4
    p4 -->|prediction, SHAP, LIME| user

    user -->|deploy, analyze drift| p5
    p5 <--> d5
    p5 -->|read logs| d4
    p5 -->|read model| d3

    user -->|manage users and roles| p6
    p6 <--> d1
    p6 -->|append only| d6
    p1 -->|registration events| d6
    p5 -->|deploy / undeploy events| d6
    p6 -->|audit entries| user
